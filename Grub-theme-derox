# DEROX OS 2.0 - Official GRUB2 Theme
# License: MIT

# الإعدادات العامة للشاشة والخلفية
desktop-image: "background.png"
desktop-color: "#050508"
title-text: ""
terminal-font: "Terminus Regular 14"
terminal-left: "0"
terminal-top: "0"
terminal-width: "100%"
terminal-height: "100%"
terminal-border: "0"

# العنوان الرئيسي والشعار النصي
+ label {
    top = 15%
    left = 0
    width = 100%
    align = "center"
    text = "DEROX OS 2.0"
    font = "DejaVu Sans Bold 32"
    color = "#b86bff"
}

+ label {
    top = 22%
    left = 0
    width = 100%
    align = "center"
    text = "FREEDOM • PERFORMANCE • INNOVATION"
    font = "DejaVu Sans Regular 12"
    color = "#d0c4e0"
}

# قائمة خيارات الإقلاع
+ boot_menu {
    left = 30%
    top = 34%
    width = 40%
    height = 35%
    item_font = "DejaVu Sans Regular 16"
    item_color = "#9b8cb0"
    selected_item_font = "DejaVu Sans Bold 16"
    selected_item_color = "#ffffff"
    item_height = 42
    item_padding = 12
    item_spacing = 10
    icon_width = 24
    icon_height = 24
    item_icon_space = 14
    menu_pixmap_style = "menu_box_*.png"
    selected_item_pixmap_style = "select_*.png"
}

# شريط العد التنازلي للإقلاع التلقائي
+ progress_bar {
    id = "__timeout__"
    left = 35%
    top = 75%
    width = 30%
    height = 8
    fg_color = "#9d4edd"
    bg_color = "#1a1423"
    border_color = "#5a189a"
    text = "@TIMEOUT_NOTIFICATION_SHORT@"
    font = "DejaVu Sans Regular 12"
    text_color = "#b86bff"
}

# التذييل السفلي
+ label {
    top = 92%
    left = 0
    width = 100%
    align = "center"
    text = "POWERED BY DEROX PROJECT"
    font = "DejaVu Sans Regular 11"
    color = "#6c5b7b"
}
